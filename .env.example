# Never put secrets in VITE_ variables. Values below are intentionally empty.
# Public challenge widget; required to submit /devis.
VITE_TURNSTILE_SITE_KEY=

# Existing optional newsletter integration (public keys only; remains unused).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only settings. Use separate development/staging/production projects.
APP_ORIGIN=http://127.0.0.1:8080
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Exactly 32 random bytes encoded in base64. Do not rotate without a logout plan.
SESSION_ENCRYPTION_KEY=
TURNSTILE_SECRET_KEY=
# Independent random values, at least 32 characters each.
RATE_LIMIT_HASH_SECRET=
JOB_RUNNER_SECRET=

# Verified transactional email provider; never use a gmail.com sender with Resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
AGENCY_NOTIFICATION_EMAIL=mekwebagency@gmail.com

# Optional until enabled. Uploads stay disabled unless BOTH are configured.
# Scanner contract is documented in docs/PLATFORM-OPERATIONS.md.
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
